---
layout: layouts/base.njk
title: Contact
permalink: /contact/
description: How to contact EyeTRU and Project FOREVER.
---
<header class="page-head">
  <div class="container">
    <span class="eyebrow">Get in touch</span>
    <h1>Contact</h1>
    <p class="lead">For collaboration, funding, student projects, media or data access, contact us by email.</p>
  </div>
</header>
<div class="container section">
  <div class="grid grid-3">
    <article class="card">
      <div class="card-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></div>
      <h3>Email</h3>
      <p><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
      {% if site.contact.phone %}<p><a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a></p>{% endif %}
    </article>
    <article class="card">
      <div class="card-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></div>
      <h3>Visit</h3>
      <address style="font-style:normal" class="muted">{% for line in site.contact.address %}{{ line }}<br>{% endfor %}</address>
      {% if site.contact.map_url %}<p><a class="arrow-link" href="{{ site.contact.map_url }}" rel="noopener">Map</a></p>{% endif %}
    </article>
    <article class="card">
      <div class="card-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></div>
      <h3>Group leader</h3>
      {% set leads = collections.people | where("category", "lead") %}
      {% for person in leads %}<p><strong>{{ person.data.name }}</strong><br><span class="muted small">{{ person.data.role }}</span><br>{% if person.data.email %}<a href="mailto:{{ person.data.email }}">{{ person.data.email }}</a>{% endif %}</p>{% endfor %}
    </article>
  </div>
  <h2 style="margin-top:3rem">Elsewhere</h2>
  <ul class="plain">{% for l in site.links %}<li><a href="{{ l.url }}" rel="noopener">{{ l.label }}</a></li>{% endfor %}</ul>
</div>
