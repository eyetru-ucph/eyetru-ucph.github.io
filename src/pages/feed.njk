---
permalink: /news/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }} news</title>
  <link href="{{ site.url }}/news/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <updated>{% if collections.news.length %}{{ collections.news[0].date.toISOString() }}{% endif %}</updated>
  {% for post in collections.news | limit(20) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <updated>{{ post.date.toISOString() }}</updated>
    <summary>{{ post.data.summary }}</summary>
  </entry>
  {% endfor %}
</feed>
