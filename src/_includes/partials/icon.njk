{# Simple line icons. Expects `t.icon`. #}
<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if t.icon == "flask" %}<path d="M9 3h6M10 3v6L4.5 18.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/><path d="M7 15h10"/>
{% elif t.icon == "pulse" %}<path d="M3 12h4l2-6 4 12 2-6h6"/>
{% elif t.icon == "chart" %}<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
{% elif t.icon == "cells" %}<circle cx="8" cy="9" r="4"/><circle cx="16" cy="15" r="5"/><circle cx="8" cy="9" r="1"/><circle cx="16" cy="15" r="1.5"/>
{% elif t.icon == "drop" %}<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>
{% elif t.icon == "grid" %}<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
{% else %}<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>{% endif %}
</svg>
