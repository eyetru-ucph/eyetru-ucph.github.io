<header class="page-head">
  <div class="container">
    {% if eyebrow %}<span class="eyebrow">{{ eyebrow }}</span>{% endif %}
    <h1>{{ title }}</h1>
    {% if intro %}<p class="lead">{{ intro }}</p>{% endif %}
  </div>
</header>
<div class="container section">
  <div class="prose">{{ content | safe }}</div>
</div>
